+/* A single moving packet illustrates the data flow without moving the content. */
+@keyframes portfolio-packet {
+  0% { left: 0; opacity: 0; }
+  15%, 80% { opacity: 1; }
+  100% { left: calc(100% - 2.5rem); opacity: 0; }
+}
+@media (prefers-reduced-motion: no-preference) {
+  .pipeline-signal { animation: portfolio-packet 3s ease-in-out 3; }
+  .hero-orbit { animation: float-card 8s ease-in-out 2; }
+}
